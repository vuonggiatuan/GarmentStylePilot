@base = http://localhost:5090
@styleId = REPLACE_WITH_STYLE_ID
@sampleId = REPLACE_WITH_SAMPLE_ID
@costId = REPLACE_WITH_COST_ID
@quoteId = REPLACE_WITH_QUOTE_ID
@lineId = REPLACE_WITH_LINE_ID
@linePlanId = REPLACE_WITH_PLAN_ID
@standardId1 = REPLACE_WITH_STANDARD_1_ID
@standardId2 = REPLACE_WITH_STANDARD_2_ID

### Create style
POST {{base}}/api/styles
Content-Type: application/json

{"code":"ST-001","customer":"Demo","description":"Performance Tee","currency":"USD"}

### Add sample
POST {{base}}/api/styles/{{styleId}}/samples
Content-Type: application/json

{"sampleType":"Fit","revision":"A","notes":"Wear test"}

### Approve sample
POST {{base}}/api/samples/{{sampleId}}/approve
Content-Type: application/json

{"approvedBy":"Sample Manager"}

### BOM (revision is incremented)
PUT {{base}}/api/styles/{{styleId}}/bom
Content-Type: application/json

[{"materialCode":"FAB-001","category":"Fabric","unit":"m","consumption":1.3,"unitPrice":2.8,"wastagePercent":5}]

### Operations (revision is incremented)
PUT {{base}}/api/styles/{{styleId}}/operations
Content-Type: application/json

[{"sequenceNo":1,"name":"Join shoulder","machineType":"Overlock","smvMinutes":0.62},{"sequenceNo":2,"name":"Attach neck rib","machineType":"Coverstitch","smvMinutes":1.24}]

### Create reusable IE operation standard
POST {{base}}/api/operation-standards
Content-Type: application/json

{"code":"GST-101","componentName":"Body","operationName":"Join shoulder","machineType":"Overlock","methodCode":"IE-STD","referenceSmvMinutes":0.62}

### Catalog list
GET {{base}}/api/operation-standards

### Import catalog selections into style's own new routing revision
POST {{base}}/api/styles/{{styleId}}/operations/from-library
Content-Type: application/json

[{"sequenceNo":1,"operationStandardId":"REPLACE_WITH_STANDARD_1_ID"},{"sequenceNo":2,"operationStandardId":"REPLACE_WITH_STANDARD_2_ID"}]

### Update standard only; historical style routing snapshot is unaffected
PUT {{base}}/api/operation-standards/{{standardId1}}
Content-Type: application/json

{"componentName":"Body","operationName":"Join shoulder","machineType":"Overlock","methodCode":"IE-STD","referenceSmvMinutes":0.88,"isActive":true}

### Approve BOM
POST {{base}}/api/styles/{{styleId}}/bom/approve
Content-Type: application/json

{"approvedBy":"Materials Manager"}

### Approve IE routing
POST {{base}}/api/styles/{{styleId}}/operations/approve
Content-Type: application/json

{"approvedBy":"IE Lead"}

### Define production line (once per factory line)
POST {{base}}/api/lines
Content-Type: application/json

{"code":"A01","name":"Sewing A01","factoryCode":"MY-PHUOC","maximumOperators":20,"shiftMinutes":480,"plannedEfficiencyPercent":85}

### Configure available machines (increments line capacity revision)
PUT {{base}}/api/lines/{{lineId}}/machines
Content-Type: application/json

[{"machineType":"OVERLOCK","availableCount":5},{"machineType":"COVERSTITCH","availableCount":5}]

### Preview conservative operation staffing / machine constraints
POST {{base}}/api/styles/{{styleId}}/line-plans/preview
Content-Type: application/json

{"productionLineId":"REPLACE_WITH_LINE_ID","targetDailyQuantity":100}

### Save plan snapshot
POST {{base}}/api/styles/{{styleId}}/line-plans
Content-Type: application/json

{"productionLineId":"REPLACE_WITH_LINE_ID","targetDailyQuantity":100}

### IE approves feasible plan for current official routing and line revision
POST {{base}}/api/line-plans/{{linePlanId}}/approve
Content-Type: application/json

{"approvedBy":"IE Lead"}

### Calculate costing
POST {{base}}/api/styles/{{styleId}}/costs
Content-Type: application/json

{"minuteRate":0.08,"overheadPerPiece":0.55,"targetMarginPercent":18}

### Approve costing
POST {{base}}/api/costs/{{costId}}/approve
Content-Type: application/json

{"approvedBy":"Costing Manager"}

### Quote
POST {{base}}/api/styles/{{styleId}}/quotes
Content-Type: application/json

{"costSheetId":"REPLACE_WITH_COST_ID","unitPrice":6.25}

### Customer accepts quotation
POST {{base}}/api/quotes/{{quoteId}}/accept

### Verify one checklist item (repeat for all readiness codes)
PUT {{base}}/api/styles/{{styleId}}/readiness/TechPackApproved
Content-Type: application/json

{"verified":true,"verifiedBy":"Technical Lead","notes":"Version A signed"}

### Check gate
GET {{base}}/api/styles/{{styleId}}/readiness

### Release only after all checks passed
POST {{base}}/api/styles/{{styleId}}/release
Content-Type: application/json

{"lineCode":"A01","plannedStartDate":"2027-01-15","approvedBy":"Production Manager"}
